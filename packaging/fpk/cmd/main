#!/bin/bash
# App Center start/stop/status for fnmusic-ext.
#   start  = bring the sources container up and enable the socket-takeover proxy
#   stop   = stop the proxy (unit ExecStopPost restores the official socket) and the container
#   status = exit 0 running / exit 3 stopped
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

UNIT="fnmusic-ext.service"

case "${1:-}" in
    start)
        [ -n "${FNMUSIC_REPO_DIR}" ] || fnmusic_fail "应用文件缺失（install.sh 不存在），请卸载后重新安装"
        [ -f "${FNMUSIC_REPO_DIR}/.env" ] || fnmusic_fail "尚未完成安装配置（.env 缺失），请卸载后重新安装"
        # 开机自启竞态：App Center 可能在官方「飞牛音乐」创建运行套接字之前调用本脚本，
        # 此时 extend.sh 的预检会立即失败，在 fnmusic-app.log 留下误导性 ERROR。
        # 这里先有界等待套接字出现；超时仍走原逻辑，由 extend.sh 输出自己的诊断，
        # systemd 单元（Restart=on-failure）随后仍会兜底拉起。
        START_SOCK_WAIT_S="${FNMUSIC_START_SOCKET_WAIT_S:-90}"
        waited=0
        if [ ! -S /var/run/trim_music.socket ] && [ ! -S /var/run/trim_music_upstream.socket ]; then
            echo "[INFO] 等待官方「飞牛音乐」运行套接字就绪（最多 ${START_SOCK_WAIT_S}s）..." >> "${FNMUSIC_LOG}"
            while [ "${waited}" -lt "${START_SOCK_WAIT_S}" ] \
                  && [ ! -S /var/run/trim_music.socket ] \
                  && [ ! -S /var/run/trim_music_upstream.socket ]; do
                sleep 2
                waited=$((waited + 2))
            done
            if [ -S /var/run/trim_music.socket ] || [ -S /var/run/trim_music_upstream.socket ]; then
                echo "[INFO] 官方「飞牛音乐」套接字已就绪（等待 ${waited}s）。" >> "${FNMUSIC_LOG}"
            else
                echo "[WARN] 等待 ${START_SOCK_WAIT_S}s 后仍未检测到官方音乐套接字，继续交给 extend.sh 预检诊断。" >> "${FNMUSIC_LOG}"
            fi
        fi
        # extend.sh is idempotent: ensures the unit exists, starts the proxy and
        # takes over /var/run/trim_music.socket. Non-TTY never prompts.
        if ! bash "${FNMUSIC_REPO_DIR}/extend.sh" >> "${FNMUSIC_LOG}" 2>&1; then
            tail -n 5 "${FNMUSIC_LOG}" >&2 || true
            fnmusic_fail "启动失败：详见 ${FNMUSIC_LOG}"
        fi
        # 直接通过 CLI 调 cmd/main start 时（未带 TRIM_APPDEST / TRIM_APPNAME），
        # App Center 可能仍记录 stopped / isOpen:false（桌面图标与 /app/fnmusic-ext/ 消失）。
        # 调用 appcenter-cli start 触发一次幂等对齐（App Center 内层再次进入时带 TRIM_*，不会递归）。
        if [ -z "${TRIM_APPDEST:-}" ] && [ -z "${TRIM_APPNAME:-}" ]; then
            APP_NAME="${FNMUSIC_APP_NAME:-fnmusic-ext}"
            if [ -z "${FNMUSIC_APPCENTER_CLI+x}" ]; then
                APPCENTER_CLI="$(command -v appcenter-cli 2>/dev/null || true)"
                if [ -z "${APPCENTER_CLI}" ] && [ -x /usr/local/bin/appcenter-cli ]; then
                    APPCENTER_CLI="/usr/local/bin/appcenter-cli"
                fi
            else
                APPCENTER_CLI="${FNMUSIC_APPCENTER_CLI}"
            fi
            if [ -n "${APPCENTER_CLI}" ] && [ -x "${APPCENTER_CLI}" ]; then
                if "${APPCENTER_CLI}" start "${APP_NAME}" >> "${FNMUSIC_LOG}" 2>&1; then
                    app_state="$("${APPCENTER_CLI}" status "${APP_NAME}" 2>/dev/null | tr -d '\r\n' || true)"
                    if [ "${app_state}" = "running" ]; then
                        echo "[INFO] 已复核并对齐应用中心状态 (${APP_NAME}: ${app_state})" >> "${FNMUSIC_LOG}"
                    else
                        echo "[WARN] 已调用 appcenter-cli start ${APP_NAME}，当前状态为 ${app_state:-unknown}，请复核桌面入口" >> "${FNMUSIC_LOG}"
                    fi
                else
                    echo "[WARN] appcenter-cli start ${APP_NAME} 未返回 0，请复核应用中心状态与桌面入口" >> "${FNMUSIC_LOG}"
                fi
            fi
        fi
        exit 0
        ;;
    stop)
        # Stopping the unit restores the official socket via ExecStopPost.
        systemctl stop "${UNIT}" >> "${FNMUSIC_LOG}" 2>&1 || true
        if [ -n "${FNMUSIC_REPO_DIR}" ] && [ -f "${FNMUSIC_REPO_DIR}/docker-compose.yml" ]; then
            docker compose -f "${FNMUSIC_REPO_DIR}/docker-compose.yml" stop >> "${FNMUSIC_LOG}" 2>&1 || true
        fi
        exit 0
        ;;
    status)
        if systemctl is-active --quiet "${UNIT}"; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
